{
  "name": "orca-ppt",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node tools/brand-dev-electron.mjs && node tools/dev.mjs",
    "serve": "pnpm build && node apps/server/dist/serve.js",
    "orca-ppt": "node apps/cli/dist/main.js",
    "build": "pnpm -r build",
    "typecheck": "tsc -b && tsc -p apps/web",
    "test": "vitest run",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "package": "pnpm build && node tools/package.mjs"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/osx-sign": "^2.7.1",
    "@electron/packager": "^20.3.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.0.0",
    "electron-winstaller": "^5.4.4",
    "esbuild": "^0.28.2",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.10"
  }
}
