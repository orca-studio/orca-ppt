# Dependencies
node_modules/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Logs
npm-debug.log*
*.log

# Env / local config
.env
.env.*
.claude/settings.local.json

# Examples: only publish the minimal story-circle demo
examples/*
!examples/story-circle/
!examples/editorial-forest/
!examples/soft-editorial/
!examples/emerald-editorial/
!examples/editorial-tri-tone/
!examples/emerald-bento/
!examples/tritone-bento/
!examples/forest-bento/
!examples/spec-wall/
!examples/forest-timeline/

# 稿子引用的素材（整页视频的片源）
!examples/_assets/
examples/_assets/*
!examples/_assets/clips/

# npm run dev 生成的本地预览页和缩略图
/index.html
examples/*/thumb.jpg

# build-site.mjs 的产物
/site/

# 验证配色时渲的组合样张（theme--palette.jpg），不进仓库
runtime/themes/samples/*--*.jpg

# wrangler 本地缓存
.wrangler/

# 产品共享元素教学案例（保留源文件，不提交录制产物）
!examples/drink-showcase/
examples/drink-showcase/index.mp4
examples/drink-showcase/capture-report.json

# 同款：保留配方和样稿，不提交录制产物
recipes/*/index.mp4
recipes/*/capture-report.json
